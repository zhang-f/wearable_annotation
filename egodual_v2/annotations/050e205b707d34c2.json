  "task": "Making microwave scrambled eggs with cheese and salsa",
  "domain": "Chef",
  "query": "How do I make microwave scrambled eggs with cheese and salsa?",
  "goal": {
    "title": "Prepare microwave eggs with cheese and salsa",
    "description": "Crack two eggs into a bowl and beat them with milk. Microwave in two rounds, stirring and salting between rounds, then top the cooked eggs with shredded cheese and salsa.",
    "final_state": "A yellow bowl of puffed cooked eggs topped with shredded cheese and a mound of salsa rests on the worktop. The fork lies beside it and the salsa jar is closed.",
    "procedure": [
      {
        "start": 0,
        "end": 27.36,
        "description": "Pick up and tap an egg against the counter, split the shell over the yellow bowl, then repeat with a second egg. Move empty shells aside and pinch at a possible shell fragment inside the bowl. Unscrew the carton cap, pour milk into the raw eggs, recap and set down the carton, then beat the mixture with a fork while holding the bowl."
      },
      {
        "start": 27.36,
        "end": 58.46,
        "description": "Lift the bowl, leave the fork on the counter and carry the bowl to the microwave. Open the door with the left hand, place the bowl inside with the right, close the door and press the control to start. Wait beside the running microwave, then open it before the displayed countdown has finished and retrieve the bowl."
      },
      {
        "start": 58.46,
        "end": 66.51,
        "description": "Carry the bowl back to the worktop, take up the fork and stir the still-fluid, partly cooked eggs. Hold the fork in the right hand while the left picks up the salt shaker, shakes salt over the mixture and returns the shaker. Stir again and lift the bowl."
      },
      {
        "start": 66.51,
        "end": 124.13,
        "description": "Set the fork down, carry the bowl to the still-open microwave and transfer it to the right hand. Place it on the turntable, close the door, set the controls and start a second heating period. Wait beside the appliance, open it with17seconds still displayed and remove the now puffed egg mixture. Carry the bowl back and lower it onto the worktop."
      },
      {
        "start": 124.13,
        "end": 154,
        "description": "Pick up the fork and briefly pause beside the cooked eggs. Put the fork down, open the shredded-cheese bag and shake cheese directly over the eggs. Reseal and set aside the bag, open the salsa jar and put its lid down. Use the fork to scoop salsa from the tilted jar onto the cheese-topped eggs, lay the fork down, close the jar and leave the completed bowl on the counter."
      }
    ]
  },
