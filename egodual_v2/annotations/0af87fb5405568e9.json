  "task": "Tightening loose drawer handles",
  "domain": "Handyman",
  "query": "How do I tighten loose drawer handles?",
  "goal": {
    "title": "Tighten and check a desk drawer handle",
    "description": "Open a desk drawer, adjust the inner handle fastener by hand and with two screwdrivers, then repeatedly operate the drawer by the knob and make a final fingertip adjustment.",
    "final_state": "The drawer is closed and the hands have released the knob. The handle remains attached throughout repeated opening and closing; its actual fastening torque cannot be measured visually.",
    "procedure": [
      {
        "start": 0,
        "end": 11.1,
        "description": "Pull the desk drawer outward. Hold the outside handle with the right hand while reaching inside with the left and repeatedly turning the inside fastener with fingertips."
      },
      {
        "start": 11.1,
        "end": 26.35,
        "description": "Reach onto the desk for a black-handled screwdriver, carry it to the open drawer, seat its tip against the inner handle screw and rotate it using both hands. Withdraw it and return it to the desktop."
      },
      {
        "start": 26.35,
        "end": 62.78,
        "description": "Pick up the slimmer blue-handled screwdriver and position it at the same inside drawer-front fastener. Rotate it repeatedly with the left hand while stabilizing it, briefly withdraw and reposition it, transfer it into the right hand and continue turning. Withdraw the tool and set it on the desk."
      },
      {
        "start": 62.78,
        "end": 89.6,
        "description": "Grip the outer knob with the right hand and repeatedly push the drawer closed and pull it open, leaving it open briefly between trials. Reach inside with the left hand for a final fingertip turn on the handle screw while the right holds the knob. Close the drawer and release it."
      }
    ]
  },
