  "task": "Cleaning and reattaching a bathroom fan cover",
  "domain": "Handyman",
  "query": "How do I clean and reattach a bathroom fan cover?",
  "goal": {
    "title": "Clean and reinstall the bathroom fan cover",
    "description": "Open the breaker panel and operate a switch, then enter the bathroom and remove the blue grille cover by undoing its two fasteners. Wipe both sides and slats of the cover with a pink cloth and wipe the exposed housing. Prepare the cover screws and repeatedly attempt to realign the grille, set down the screwdriver and reseat the cover, then start the fasteners by hand and tighten the right fastener with the screwdriver. Press the mounted cover, set the tool on the step stool, return to the breaker panel, operate the switch again and close the panel.",
    "final_state": "The blue cover is refitted over the wall housing and the breaker panel is closed. No audio or airflow evidence establishes fan operation.",
    "procedure": [
      {
        "start": 0,
        "end": 5.0,
        "description": "Reach up, open the breaker panel, flip a switch and withdraw the hand. The switch label and direction cannot be established from the frames."
      },
      {
        "start": 5.0,
        "end": 37.46,
        "description": "Move into the bathroom, steady the cover and unscrew its right and left fasteners by hand. Pull the cover away, take it to the sink counter and set down the cover and loose screws."
      },
      {
        "start": 37.46,
        "end": 67.31,
        "description": "Take the pink cloth and wipe the front, rear, slats and edges of the cover. Set the cover down, raise the cloth to the open housing, wipe the accessible rim/interior, then return and set the cloth aside."
      },
      {
        "start": 67.31,
        "end": 115.46,
        "description": "Take a fastener, position it in a cover hole, collect the screwdriver and bring the cover back to the wall. Try to align and thread the fastener, adjust the cover repeatedly, then remove it and set the screwdriver down."
      },
      {
        "start": 115.46,
        "end": 153.0,
        "description": "Raise and reseat the cover repeatedly, turn the left screw by hand and then work the right screw. Retrieve the screwdriver after the cover is held in position."
      },
      {
        "start": 153.0,
        "end": 195.64,
        "description": "Position the driver on the right screw and turn it repeatedly. Finish the visible tightening, press the cover, descend and place the screwdriver on the step stool."
      },
      {
        "start": 195.64,
        "end": 202.15,
        "description": "Return to the open breaker panel, flip the switch and close the panel door."
      }
    ]
  },
