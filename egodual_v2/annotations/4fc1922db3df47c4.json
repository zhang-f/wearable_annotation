  "task": "Replacing a garden hose washer",
  "domain": "Handyman",
  "query": "How do I replace a garden hose washer?",
  "goal": {
    "title": "Replace the sealing washer in a garden hose coupling",
    "description": "Set tools and a yellow cloth beside an outdoor faucet, loosen and disconnect the hose, and briefly test the spray nozzle. Work the old rubber washer out of the brass hose coupling using pliers and a screwdriver, then press a replacement washer into the coupling. Reconnect the hose, wipe the faucet area and test the spray again.",
    "final_state": "The hose has been reattached to the outdoor faucet and water is sprayed through its nozzle after the washer work. Small removed washers and tools remain near the bucket.",
    "procedure": [
      "Place the cloth and tools beside the outdoor faucet.",
      "Loosen the hose connection and check water flow through the nozzle.",
      "Disconnect the hose and expose the washer in the brass coupling.",
      "Use pliers and a screwdriver to free and remove the old washer.",
      "Press a replacement washer into the coupling and check its seating.",
      "Reconnect the hose, wipe the connection area and test the spray nozzle."
    ]
  },
  "object_inventory": [
    "garden hose",
    "hose coupling",
    "faucet",
    "spray nozzle",
    "pliers",
    "screwdriver",
    "washer",
