    "ground"
  ],
  "phases": [
    {
      "start": 0,
      "end": 27.99,
      "description": "Set down the cloth and tools, turn the faucet handle and loosen the attached hose coupling with pliers and fingers."
    },
    {
      "start": 27.99,
      "end": 50.2,
      "description": "Operate the faucet and spray nozzle briefly, then return to the tap and unscrew the hose connection."
    },
    {
      "start": 50.2,
      "end": 94.28,
      "description": "Inspect the brass opening, arrange the cloth and hose, and repeatedly pry the washer with pliers and a screwdriver. Remove the loosened washer and pick up a replacement."
    },
    {
      "start": 94.28,
      "end": 110.1,
      "description": "Insert the washer and press around its edge with the fingertips. Set the tool aside and check that the ring lies within the coupling."
    },
    {
      "start": 110.1,
      "end": 145.31,
      "description": "Carry the coupling back to the tap, thread it on, put tools down and wipe the faucet area. Raise and squeeze the spray nozzle to test the connected hose."
    }
  ],
