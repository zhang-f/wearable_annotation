  "domain": "Chef",
  "query": "How do I make a microwave egg sandwich?",
  "goal": {
    "title": "Make a microwave-cooked egg sandwich",
    "description": "Crack and beat an egg in a bowl, microwave it under a cover in several short cycles with checks and stirring, then loosen the cooked egg onto bread and close the sandwich.",
    "final_state": "A closed egg sandwich rests on a folded paper towel on the counter.",
    "procedure": [
      "Crack egg into bowl, discard shell beside bread and add a small amount of water from the cup.",
      "Beat the egg thoroughly with a fork.",
      "Put the bowl in the microwave, cover it and heat, checking and stirring between short heating cycles.",
      "Remove the cooked egg, loosen it with a fork and tip it onto a bread slice.",
      "Place the second bread slice on top, press sandwich and fold paper towel beneath it."
    ]
  },
