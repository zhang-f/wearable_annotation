{
  "video_id": "6d839f832037b10b",
  "duration": 171.2,
  "task": "Installing a wall-mounted hand sanitizer holder",
  "domain": "Handyman",
  "query": "How do I install a wall-mounted hand sanitizer holder?",
  "goal": {
    "title": "Install a wire holder for a pump bottle on a cabinet door",
    "description": "Retrieve a tape measure, small hardware and hammer from the cabinet. Measure a position on the closed door and try driving a nail near the hanging towel. Reopen the cabinet, remeasure the door and secure the wire hook at the revised position with the hammer. Hang the green-liquid pump bottle on the hook, adjust its neck and test the pump repeatedly. Remove the bottle, reinforce the hook with additional hammer taps and hang the bottle again.",
    "final_state": "The pump bottle hangs from the wire holder on the cabinet door and its pump is pressed again.",
    "procedure": [
      "Gather the tape measure and hammer and measure the door.",
      "Try the initial nail position and remeasure the mounting location.",
      "Hammer the wire holder onto the door.",
      "Hang the bottle and test its pump.",
      "Reinforce the holder and hang the bottle again."
    ]
  },
  "object_inventory": [
    "tape measure",
    "hammer",
    "nail",
    "wire hook",
    "cabinet door",
    "pump bottle",
    "cabinet shelf"
  ],
  "phases": [
    {
      "start": 0,
      "end": 29.97,
      "description": "Retrieve small hardware and the tape measure, close the door and measure vertically before collecting the hammer."
    },
    {
      "start": 29.97,
      "end": 47.25,
      "description": "Hold the nail against the door below the towel, hammer it and bring the wire hook to the door."
    },
    {
      "start": 47.25,
      "end": 78.18,
      "description": "Measure the door repeatedly, including a measurement from lower down, then return the tape measure to the cabinet."
    },
    {
      "start": 78.18,
      "end": 108.96,
      "description": "Bring the hammer and nail back to the door, position the wire hook and repeatedly tap its fastener before putting the hammer away."
    },
    {
      "start": 108.96,
      "end": 157.28,
      "description": "Hang the bottle on the hook, adjust it and repeatedly press its pump above the palm; remove and rehang the bottle while checking its support."
    },
    {
      "start": 157.28,
      "end": 170.18,
      "description": "Put the bottle aside, hammer the holder fastener again, return the hammer and hang and operate the bottle once more."
    }
  ],
