  "goal": {
    "title": "Apply felt pads to a small chair's legs",
    "description": "Flip a small white wooden chair upside down and clean each turned-wood leg first with disposable wipes from a container and then with a cloth. Peel felt pads one at a time from a backing sheet and press each onto the bottom of a chair leg, adjusting and re-pressing several pads to seat them firmly. Finish by rotating the chair to check that a felt pad is seated on every leg.",
    "final_state": "All four legs of the chair have a felt pad pressed onto their bottom tip; the chair is still upside down and being rotated for a final check as the video ends.",
    "procedure": [
      "Turn the furniture upside down and take a disposable wipe.",
      "Wipe the exposed wooden legs with wipes and a cloth.",
      "Peel felt pads from the backing sheet and press them onto leg ends.",
      "Continue applying and adjusting pads on the other leg ends.",
      "Rotate the furniture and press or inspect the fitted pads."
    ]
  },
