  "phases": [
    {
      "start": 0,
      "end": 23.6,
      "description": "Disconnect the cord, release both metal filters and remove both round covers. Carry the round covers to the sink."
    },
    {
      "start": 23.6,
      "end": 61.08,
      "description": "Rinse the first cover, obtain a sponge and dish soap, scrub its surfaces and rinse away the soap. Set it back in the sink."
    },
    {
      "start": 61.08,
      "end": 95.72,
      "description": "Apply fresh soap to the sponge and scrub the other cover. Rinse it while turning it, then set both washed covers on the counter."
    },
    {
      "start": 95.72,
      "end": 123.74,
      "description": "Obtain paper towels, dry both covers and briefly wipe the counter. Collect a dried cover and move back toward the hood."
    },
    {
      "start": 123.74,
      "end": 155.85,
      "description": "Attach both round covers inside the hood and fit each metal baffle filter back into its opening. Secure their front edges."
    },
    {
      "start": 155.85,
      "end": 181.19,
      "description": "Reconnect the hood power cord and press several controls on the illuminated front panel."
    }
  ],
