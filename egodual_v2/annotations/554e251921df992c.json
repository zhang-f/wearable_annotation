  "task": "Cleaning and reinstalling a range hood filter",
  "domain": "Handyman",
  "query": "How do I clean and reinstall a range hood filter?",
  "goal": {
    "title": "Clean and reinstall the range hood filter assembly",
    "description": "Disconnect the hood, remove two metal baffle filters and two round black filter covers, and carry the round covers to the sink. Wash both round covers with dish soap and a sponge, rinse and dry them, then reinstall the covers and metal filters. Reconnect power and operate the hood controls.",
    "final_state": "Both metal filters are fitted under the hood and the cord is reconnected. The final frames show the assembled hood with its illuminated display after the controls are tested.",
    "procedure": [
      "Disconnect the range hood power cord.",
      "Remove both metal baffle filters and the two round filter covers.",
      "Wash and rinse each round cover using dish soap and a sponge.",
      "Dry the washed covers with paper towels.",
      "Reinstall the round covers, then seat and secure the metal filters.",
      "Reconnect the cord and test the hood controls."
    ]
  },
