# videos are 23GB total, never commit them
videos/
*.mp4
*.mov
*.avi
*.mkv

# annotation output is user-generated locally, sent back out-of-band
# (email/drive), not meant to accumulate in this repo automatically
annotations/raw/
annotations/*.jsonl
!annotations/.gitkeep

# python
__pycache__/
*.pyc
.venv/
venv/

# node (in case any analysis tooling ends up using it)
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# vlm/ module: frame-extraction working dirs, run logs, and generated
# review pages are all local build artifacts, not source -- the small
# example jsonls under vlm/examples/ are intentionally NOT covered by
# this and stay tracked.
vlm/workdir*/
vlm/**/frames_s1/
vlm/**/frames_s2/
*.log
vlm/**/review.html
vlm/**/*.mp4

# vlm/ pipeline outputs, intermediate archives (pass0/narrations/fine_raw/refined),
# review bundles, and generated review-page directories -- all local build artifacts
vlm/outputs/
vlm/phase1_review/
vlm/phase1v3_review/
vlm/gemini_review/
vlm/final_review/

# machine-specific scratch data (regenerate the keep list from screening_decisions.json)
/videos
vlm/keep_list.txt
vlm/selected.jsonl
vlm/bootstrap_coarse.jsonl
vlm/bootstrap_fine.jsonl
