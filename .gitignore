# videos are 23GB total, never commit them
videos/
*.mp4
*.mov
*.avi
*.mkv

# annotation output is user-generated locally, sent back out-of-band
# (email/drive), not meant to accumulate in this repo automatically
annotations/raw/
annotations/*.jsonl
!annotations/.gitkeep

# python
__pycache__/
*.pyc
.venv/
venv/

# node (in case any analysis tooling ends up using it)
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# vlm/ module: frame-extraction working dirs, run logs, and generated
# review pages are all local build artifacts, not source -- the small
# example jsonls under vlm/examples/ are intentionally NOT covered by
# this and stay tracked.
vlm/workdir*/
vlm/**/frames_s1/
vlm/**/frames_s2/
*.log
vlm/**/review.html
vlm/**/*.mp4

# vlm/ pipeline outputs, intermediate archives (pass0/narrations/fine_raw/refined),
# review bundles, and generated review-page directories -- all local build artifacts.
# Exception: vlm/outputs/final/annotations_{coarse,fine}_qc.jsonl and
# review_priority.json ARE tracked (force-added, deliberately overriding this
# ignore) -- they're the data prerequisite review_workbench needs, see its
# README's "Data prerequisites" section. Everything else under vlm/outputs/
# stays untracked (draft_v2 jsonl, per-video archives, etc.).
vlm/outputs/
vlm/phase1_review/
vlm/phase1v3_review/
vlm/gemini_review/
vlm/final_review/

# machine-specific scratch data (regenerate the keep list from screening_decisions.json)
/videos
vlm/keep_list.txt
vlm/selected.jsonl
vlm/bootstrap_coarse.jsonl
vlm/bootstrap_fine.jsonl

# review_workbench: reviewer corrections/claim-state are work product, not
# code -- regenerate assignment.json via init_assignment.py, corrections/
# accumulates from actual review sessions. See vlm/corrections/README.md.
vlm/corrections/*.jsonl
vlm/corrections/.*.lock
!vlm/corrections/.gitkeep
vlm/review_workbench/assignment.json
vlm/review_workbench/assignment.json.lock
